{
  "version": 2,
  "builds": [
    {
      "src": "api/frontend.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "app/frontend/**",
          "config/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/frontend.js"
    }
  ]
}

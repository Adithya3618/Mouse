# Copy this file to .env and fill in real values. .env is gitignored - never
# commit real credentials.

# UF NaviGator (https://api.ai.it.ufl.edu) Bearer API key used to call the
# hosted Whisper Large v3 transcription endpoint
# (POST https://api.ai.it.ufl.edu/v1/audio/transcriptions, model
# "whisper-large-v3"). Server-side only - never sent to the browser. If this
# is unset, app/backend/transcription/index.js falls back to a stub provider
# (loudly logged) so local development and the test suite never need network
# access or a real key.
UF_NAVIGATOR_API_KEY=

# Shared-secret bearer token required on every /api/admin/* request (the
# research/admin dashboard). This is a minimal placeholder - swap for real
# institutional auth (e.g. UF Shibboleth/SSO) before production use.
ADMIN_API_TOKEN=

# --- Storage provider selection (see docs/storage-architecture.md) ---
# Both default to sqlite/local with nothing set below - npm start needs no
# configuration for local development.

# DATABASE_PROVIDER=sqlite | postgres
# DATABASE_URL=                    # required only when DATABASE_PROVIDER=postgres
#                                   # a standard Postgres connection string -
#                                   # works with Neon, UF Postgres, RDS, etc.

# AUDIO_STORAGE_PROVIDER=local | object
# OBJECT_STORAGE_CLIENT=           # required only when AUDIO_STORAGE_PROVIDER=object
#                                   # (no client is implemented yet - see
#                                   # docs/storage-architecture.md)

# --- Persistent storage location (production/UF server) ---
# DATA_DIR is a single convenience root: DATA_DIR/db holds the SQLite
# primary/secondary files, DATA_DIR/audio + DATA_DIR/audio-secondary hold
# recordings. Point this at a real, persistent filesystem path on the
# server - e.g. /var/lib/mouse-research (kept OUTSIDE the application code
# directory, so redeploying code never touches it). Leave unset for local
# development (defaults to the project-relative data/ directory).
# DATA_DIR=/var/lib/mouse-research

# More specific overrides - if set, these win over DATA_DIR individually.
# DB_PATH=data/db
# AUDIO_STORAGE_DIR=data/audio

# Set to "production" on any real server deployment (this is the standard
# Node.js convention, not specific to any hosting provider). When set, the
# application REFUSES TO START unless persistent storage has been
# explicitly configured above (DATA_DIR/DB_PATH, or DATABASE_PROVIDER=postgres
# with DATABASE_URL) - this is what prevents research data from silently
# ending up on non-persistent storage. Leave unset for local development.
# NODE_ENV=production
